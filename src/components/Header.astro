---
import Logo from "./Logo.astro";
---

<header
  id="header-nav"
  class="fixed w-screen py-4 z-50 text-white backdrop-blur-sm top-0 px-8 lg:px-0"
>
  <div class="grid grid-cols-3 max-w-7xl mx-auto items-center justify-between">
    <img src="/Logo.png" alt="Logo" class="w-14" />
    <nav class="col-span-1 justify-self-center">
      <ul class="flex gap-4 text-white">
        <li>
          <a class="hover:underline" href="#">INICIO</a>
        </li>
        <li>
          <a class="hover:underline" href="#">INFORMACION</a>
        </li>
        <li>
          <a class="hover:underline" href="#">CONTACTO</a>
        </li>
      </ul>
    </nav>
    <a href="#" class="col-span-1 justify-self-end">MIS PROYECTOS</a>
  </div>
</header>
